{
  "name": "openbook-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vite",
    "dev:inspect": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048 --inspect\" vite",
    "dev:debug": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vite --debug",
    "build": "vite build",
    "preview": "vite preview",
    "dev:backend": "cd ../../py_services && python -m uvicorn api_server:app --reload --port 8010",
    "dev:all": "concurrently -n \"frontend,backend\" -c \"blue,green\" \"npm run dev\" \"npm run dev:backend\""
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.2.1",
    "@sveltejs/adapter-static": "^3.0.3",
    "@sveltejs/kit": "^2.6.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "svelte": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "5.2.0",
    "vite-plugin-devtools-json": "^1.0.0"
  },
  "dependencies": {
    "@iconify-icons/material-symbols": "^1.2.58",
    "@iconify/svelte": "^5.2.1",
    "@tauri-apps/api": "^2.9.0",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "jose": "^6.1.0",
    "lucide-svelte": "^0.546.0"
  }
}
