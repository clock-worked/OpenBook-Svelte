{
  "description": "Cross-language parity vectors for character identity primitives. TS: apps/desktop/src/lib/services/characterIdentity.ts (vitest: apps/desktop/src/lib/services/__tests__/characterIdentity.test.ts). Python: py_services/character_store.py (unittest: py_services/test_character_identity_parity.py). Keep both tests green when changing either side.",
  "sanitize": [
    { "title": "Alice", "expected": "Alice" },
    { "title": "  padded  ", "expected": "padded" },
    { "title": "", "expected": "-" },
    { "title": "   ", "expected": "-" },
    { "title": "con", "expected": "-con" },
    { "title": "CON", "expected": "-CON" },
    { "title": "aux", "expected": "-aux" },
    { "title": "COM1", "expected": "-COM1" },
    { "title": "NUL ", "expected": "-NUL" },
    { "title": "a/b", "expected": "a-b" },
    { "title": "a\\b", "expected": "a-b" },
    { "title": "a:b", "expected": "a-b" },
    { "title": "a*b", "expected": "a-b" },
    { "title": "a?b", "expected": "a-b" },
    { "title": "a\"b", "expected": "a-b" },
    { "title": "a<b", "expected": "a-b" },
    { "title": "a>b", "expected": "a-b" },
    { "title": "a|b", "expected": "a-b" },
    { "title": "a\u0000b", "expected": "a-b" },
    { "title": "a\u001fb", "expected": "a-b" },
    { "title": "a\u007fb", "expected": "a-b" },
    { "title": "a\u007f", "expected": "a" },
    { "title": "a..b", "expected": "a..b" },
    { "title": "--dash-leading", "expected": "dash-leading" },
    { "title": "trailing--", "expected": "trailing" },
    { "title": "The Boss", "expected": "The Boss" },
    { "title": "café", "expected": "café" },
    { "title": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA/", "expected": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" },
    { "title": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "expected": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" }
  ],
  "normalize": [
    { "value": null, "expected": "" },
    { "value": 123, "expected": "123" },
    { "value": "  ABC  ", "expected": "abc" },
    { "value": "MiXeD", "expected": "mixed" },
    { "value": "", "expected": "" },
    { "value": "a-b_c", "expected": "a-b_c" }
  ],
  "guids": [
    { "value": "AB12CD34", "valid": true },
    { "value": "ab12cd34", "valid": false },
    { "value": "AB12CD3I", "valid": false },
    { "value": "AB12CD3L", "valid": false },
    { "value": "AB12CD3O", "valid": false },
    { "value": "AB12CD3U", "valid": false },
    { "value": "AB12CD3", "valid": false },
    { "value": "AB12CD345", "valid": false },
    { "value": "AB-1CD34", "valid": false },
    { "value": "", "valid": false },
    { "value": 12345678, "valid": false },
    { "value": "AB12CD3G", "valid": true }
  ]
}
